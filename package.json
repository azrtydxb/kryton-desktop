{
  "name": "kryton-desktop",
  "version": "4.4.0-pre.8",
  "private": true,
  "type": "module",
  "description": "Kryton desktop app (Tauri + React)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azrtydxb/kryton-desktop.git"
  },
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "vite:dev": "vite",
    "vite:build": "node scripts/copy-wasm.js && tsc -b && vite build",
    "copy-wasm": "node scripts/copy-wasm.js",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:link": "node scripts/dev-link.js link",
    "dev:unlink": "node scripts/dev-link.js unlink",
    "dev:verify": "node scripts/dev-link.js verify",
    "prepare": "husky"
  },
  "dependencies": {
    "@azrtydxb/core": "4.4.0-pre.9",
    "@azrtydxb/core-react": "4.4.0-pre.9",
    "@azrtydxb/ui": "4.4.0-pre.9",
    "@tauri-apps/api": "^2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sql.js": "^1.10.0",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.0",
    "@vitejs/plugin-react": "^4.0.0",
    "husky": "^9.1.7",
    "typescript": "^5.6.0",
    "vite": "^5.0.0",
    "vitest": "^1.6.1"
  }
}
