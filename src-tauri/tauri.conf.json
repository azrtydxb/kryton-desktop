{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Kryton",
  "version": "0.1.3",
  "identifier": "app.kryton.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["kryton"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM0N0Y3MUE1OTEyQzg0NEYKUldSUGhDeVJwWEYveEVOY01VN05kalAvNEkzSWhpSWRXdlZ1bGsyNXREQnpRbmQweEpxU09EODgK",
      "endpoints": [
        "https://github.com/azrtydxb/kryton-desktop/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
