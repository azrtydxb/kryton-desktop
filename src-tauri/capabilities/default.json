{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Shell windows: login, settings, quick-capture, plus the legacy 'main' label. These are our own Vite-built pages and may invoke any Tauri plugin we register.",
  "windows": ["main", "login", "settings", "quick-capture"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:webview:default",
    "core:menu:default",
    "core:app:default",
    "core:tray:default",
    "global-shortcut:default",
    "opener:default",
    "deep-link:default",
    "notification:default",
    "notification:allow-notify",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "updater:default",
    "dialog:default"
  ]
}
